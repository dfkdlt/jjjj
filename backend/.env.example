# DB 접속 정보
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=steam_review_app

# JWT 시크릿 (배포 시 반드시 랜덤한 긴 문자열로 변경)
JWT_SECRET=change_this_to_a_long_random_string

# 서버 포트
PORT=4000

# 프론트엔드 주소 (CORS 허용용)
FRONTEND_ORIGIN=http://localhost:5500

# (선택) AI 키워드 자동 매핑 - OpenRouter 같은 OpenAI 호환 통합 API 키를 씁니다.
# 비워두면 AI 매핑만 꺼지고, keywordMap.js에 등록된 키워드 검색은 그대로 동작합니다.
# 키는 .env에만 두고 절대 GitHub 등에 올리지 마세요.
AI_API_KEY=
# 접속 주소 (OpenRouter 기본값. 다른 OpenAI 호환 서비스면 그 주소로 변경)
AI_BASE_URL=https://openrouter.ai/api/v1
# 사용할 모델 (키가 아니라 이 값이 모델을 결정합니다. 키 발급 페이지의 모델 목록에서 이름을 복사)
AI_MODEL=anthropic/claude-haiku-4.5
# (선택) 리뷰 요약에만 다른 모델을 쓰고 싶을 때. 비우면 AI_MODEL을 그대로 씁니다.
# AI_SUMMARY_MODEL=

# (선택) 비추천 의견 반영 기준: 같은 게임에 "이 태그가 아니다"라는 의견이 서로 다른 사용자 몇 명 이상이면 모두의 검색에서 뺄지 (기본 2)
DISLIKE_THRESHOLD=2
